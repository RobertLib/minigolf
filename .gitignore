# macOS
.DS_Store

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build products
build/
DerivedData/

# Swift Package Manager
.swiftpm/
.build/

# App Store media. Only the texts in AppStore/ and the scripts in Tools/ are
# versioned — the images and videos are output, not source, a PNG will not
# compress any further in git and they would stay in the history for good.
# They are produced by:
#   Tools/appstore_media.sh      → screenshots/ (~85 MB) + preview/ (~134 MB), ~20 min
#   Tools/appstore_captions.sh   → screenshots-captioned/ (~78 MB), ~2 min
# Details in AppStore/screenshots.md.
AppStore/screenshots/
AppStore/screenshots-captioned/
AppStore/preview/

# The downloaded originals the importer reads from — a few hundred megabytes,
# and re-fetchable from the `download` URLs in Tools/music_sources.json. Only
# the encoded tracks belong in the repo.
Assets/music-src/
__pycache__/
